{
    "name": "@plurnk/plurnk-mimetypes-grammar-zig",
    "version": "2.0.0",
    "description": "Pre-built tree-sitter-zig WASM grammar for @plurnk/plurnk-mimetypes.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "default": "./index.js"
        },
        "./package.json": "./package.json",
        "./zig.wasm": "./zig.wasm"
    },
    "files": [
        "zig.wasm",
        ".grammar-source",
        ".grammar-pin",
        "index.js",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "node scripts/build-wasm.mjs",
        "verify:wasm": "node scripts/verify-wasm.mjs",
        "update:pin": "node scripts/update-pin.mjs",
        "update": "npm run update:pin && npm run build:wasm && npm run verify:wasm",
        "test": "npm run verify:wasm"
    },
    "devDependencies": {
        "tree-sitter-cli": "0.27.0"
    },
    "allowScripts": {
        "tree-sitter-cli@0.27.0": true
    },
    "peerDependencies": {
        "web-tree-sitter": "^0.25.0 || ^0.26.0 || ^0.27.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-mimetypes-grammar-zig.git"
    },
    "homepage": "https://github.com/plurnk/plurnk-mimetypes-grammar-zig#readme"
}
